# Copy to .env for local use, or set these in your host's dashboard.
# Never commit the real values.

# Signs session cookies. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First-run administrator account (only used when the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PRODUCTION: the PostgreSQL address, e.g.  postgresql://user:password@host:5432/dbname?sslmode=require
# Leave empty for local development, where the site uses the SQLite file below.
DATABASE_URL=
# Local development only (used when DATABASE_URL is empty): where the SQLite file lives.
DATABASE_PATH=
# Maximum connections each server process keeps open to PostgreSQL.
DB_POOL_MAX=10
# DEBUG, INFO, WARNING or ERROR. Logs are one JSON line each and never contain passwords, tokens or emails.
LOG_LEVEL=INFO

# 1 = show the "demonstration project" ribbon. Set to 0 for a real institution.
DEMO_MODE=1
# 1 = let search engines index the site.
ALLOW_INDEXING=0
# 1 = keep the application form open after the closing date (useful for demos).
ADMISSIONS_FORCE_OPEN=0

# Optional email (confirmations, status updates, password resets). Leave blank to run without email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MIUTM <you@example.com>
SMTP_TLS=1

# Optional: if set, the Admin register page asks for this code.
STAFF_SIGNUP_CODE=
# How many days a signed-in browser stays signed in after its last visit.
SESSION_DAYS=90
